[Unit]
Description=Commando bot for Meshtastic
Documentation={{ commando_repo }}
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory={{ commando_directory }}
ExecStart={{ commando_venv_home }}/bin/python {{ commando_directory }}/commando.py
Type=exec
Restart=always
RestartSec=30
User={{ commando_user }}
Group={{ commando_group }}
EnvironmentFile=/etc/commando/commando.env

[Install]
WantedBy=multi-user.target
